<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#d4af6a" android:textSize="12sp" android:textStyle="bold" android:singleLine="true"/>

    <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#f8f4ea" android:textSize="24sp" android:singleLine="true"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#c4baa6" android:textSize="12sp" android:singleLine="true"/>

        <Chronometer android:id="@+id/w_cd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#ecd8a6" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
