<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/w_icon" android:layout_width="24dp" android:layout_height="24dp" />
    <TextView android:id="@+id/w_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#d4af6a" android:textSize="17sp" android:textStyle="bold" android:singleLine="true"/>

    <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#f8f4ea" android:textSize="22sp" />

    <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#c4baa6" android:textSize="12sp" android:singleLine="true" android:layout_marginTop="2dp"/>

</LinearLayout>
