<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="8dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8f8672" android:textSize="12sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#d4af6a" android:textSize="24sp" android:textStyle="bold" android:singleLine="true"/>

        <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#f8f4ea" android:textSize="24sp" />

    </LinearLayout>
    <Chronometer android:id="@+id/w_cd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#c4baa6" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="5dp" android:layout_marginBottom="2dp" android:background="#33d4af6a" android:orientation="horizontal" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:orientation="horizontal">
            <TextView android:id="@+id/w_n1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#f8f4ea" android:textSize="14sp" android:singleLine="true"/>

            <TextView android:id="@+id/w_t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#f8f4ea" android:textSize="14sp" android:textStyle="bold"/>

        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:orientation="horizontal">
            <TextView android:id="@+id/w_n2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#f8f4ea" android:textSize="14sp" android:singleLine="true"/>

            <TextView android:id="@+id/w_t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#f8f4ea" android:textSize="14sp" android:textStyle="bold"/>

        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:orientation="horizontal">
            <TextView android:id="@+id/w_n3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#f8f4ea" android:textSize="14sp" android:singleLine="true"/>

            <TextView android:id="@+id/w_t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#f8f4ea" android:textSize="14sp" android:textStyle="bold"/>

        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:orientation="horizontal">
            <TextView android:id="@+id/w_n4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#f8f4ea" android:textSize="14sp" android:singleLine="true"/>

            <TextView android:id="@+id/w_t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#f8f4ea" android:textSize="14sp" android:textStyle="bold"/>

        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:orientation="horizontal">
            <TextView android:id="@+id/w_n5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#f8f4ea" android:textSize="14sp" android:singleLine="true"/>

            <TextView android:id="@+id/w_t5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#f8f4ea" android:textSize="14sp" android:textStyle="bold"/>

        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8f8672" android:textSize="11sp" android:singleLine="true"/>

</LinearLayout>
