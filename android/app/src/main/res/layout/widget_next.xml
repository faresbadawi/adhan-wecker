<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#d4af6a" android:textSize="20sp" android:textStyle="bold" android:singleLine="true"/>

        <Chronometer android:id="@+id/w_cd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#c4baa6" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#f8f4ea" android:textSize="24sp" />

</LinearLayout>
