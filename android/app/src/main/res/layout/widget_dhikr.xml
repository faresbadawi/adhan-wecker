<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#d4af6a" android:textSize="12sp" android:textStyle="bold"/>

    <TextView android:id="@+id/w_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#ecd8a6" android:textSize="19sp" android:gravity="center" android:layout_marginTop="4dp" android:maxLines="3"/>

    <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8f8672" android:textSize="11sp" android:layout_marginTop="6dp" android:singleLine="true"/>

</LinearLayout>
